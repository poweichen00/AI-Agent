# AgentX 環境配置模板
# AgentX 使用 AGENTX_ 環境變數字首，執行資料存於 ~/.agentx。
# 用法：cp .env.example .env，然後按需修改

# ── Core Daemon ───────────────────────────────────────────────
AGENTX_HOST=127.0.0.1
AGENTX_PORT=7437

# ── Logging ───────────────────────────────────────────────────
AGENTX_LOG_LEVEL=INFO
# 留空則僅輸出 stderr，不寫檔案
AGENTX_LOG_FILE=~/.agentx/logs/core.log
# text（人工可讀鍵值對）或 json（結構化，適合日誌聚合）
AGENTX_LOG_FORMAT=text

# ── Config File ───────────────────────────────────────────────
# AGENTX_CONFIG=~/.agentx/config.toml

# ── LLM（S1 階段啟用）────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# AGENTX_LLM_DEFAULT_MODEL=claude-sonnet-4-6
# AGENTX_MAX_STEPS=20
