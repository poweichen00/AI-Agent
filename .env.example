# AgentX 環境配置模板
# 為保留舊版配置相容性，目前環境變數字首仍使用 KAMA_，資料仍存於 ~/.kama。
# 用法：cp .env.example .env，然後按需修改

# ── Core Daemon ───────────────────────────────────────────────
KAMA_HOST=127.0.0.1
KAMA_PORT=7437

# ── Logging ───────────────────────────────────────────────────
KAMA_LOG_LEVEL=INFO
# 留空則僅輸出 stderr，不寫檔案
KAMA_LOG_FILE=~/.kama/logs/core.log
# text（人工可讀鍵值對）或 json（結構化，適合日誌聚合）
KAMA_LOG_FORMAT=text

# ── Config File ───────────────────────────────────────────────
# KAMA_CONFIG=~/.kama/config.toml

# ── LLM（S1 階段啟用）────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# KAMA_LLM_DEFAULT_MODEL=claude-sonnet-4-6
# KAMA_MAX_STEPS=20
